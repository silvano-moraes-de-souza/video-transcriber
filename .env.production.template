# ============================================================
# GITHUB SECRETS (para GitHub Actions deploy)
# Configure em: GitHub → Settings → Secrets and variables → Actions
# ============================================================

VERCEL_TOKEN=vercel_xxxxxxxxxxxxxxxx
VERCEL_ORG_ID=team_xxxxxxxxxxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxx

# ============================================================
# COMO OBTER CADA VALOR
# ============================================================

# SUPABASE_URL / SUPABASE_SECRET_KEY:
#   Supabase Dashboard → Project → Settings → API
#   URL = Project URL
#   SUPABASE_SECRET_KEY = service_role (NÃO anon key)

# JOB_HMAC_SECRET:
#   Gere: openssl rand -hex 32
#   Ou: python -c "import secrets; print(secrets.token_hex(32))"

# OPENAI_API_KEY:
#   platform.openai.com → API Keys → Create new secret key

# VERCEL_TOKEN:
#   vercel.com/account/tokens → Create

# VERCEL_ORG_ID / VERCEL_PROJECT_ID:
#   Após primeiro deploy: vercel inspect <deployment-url> --token=$VERCEL_TOKEN
#   Ou: Vercel Dashboard → Project → Settings → General